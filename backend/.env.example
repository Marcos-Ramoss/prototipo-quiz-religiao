# ========================================================
# VARIÁVEIS DE AMBIENTE - POC QUIZ RELIGIOSO IA
# Copie este arquivo para .env e preencha seus valores
# ========================================================

# Porta da API Spring Boot
SERVER_PORT=8080

# Chave de API Google Gemini (obtenha em https://aistudio.google.com/)
# Se deixado em branco, a aplicação opera em modo fallback para demonstração
GEMINI_API_KEY=

# Modelo da IA Generativa
GEMINI_MODEL=gemini-3.5-flash

# Timeout em segundos para requisições de IA
AI_TIMEOUT_SECONDS=25

# Origem permitida para o Frontend Angular (separadas por vírgula se houver mais de uma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Tempo de vida (TTL) da sessão temporária do Quiz em minutos
QUIZ_SESSION_TTL_MINUTES=60
